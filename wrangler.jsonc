{
  // Cloudflare bu depoyu "statik varlikli Worker" olarak yayinliyor.
  // Tek pakette iki is: dist/ icindeki site + /api/nabiz bildirim ucu.
  "name": "7ler-demo",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-16",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Bu yol her zaman Worker'a gitsin; statik dosyaya dusup kaybolmasin.
    "run_worker_first": ["/api/*"]
  }
}
